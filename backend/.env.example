# PlayNova Backend Environment Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/playnova?retryWrites=true&w=majority
MONGODB_URI=

# Cryptographically Secure JWT & Cookie Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars

# Token Lifetime
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# YouTube Data API v3 (Server-Side Only — NEVER expose via NEXT_PUBLIC_*)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
YOUTUBE_REGION_CODE=US
YOUTUBE_DAILY_QUOTA_LIMIT=10000
